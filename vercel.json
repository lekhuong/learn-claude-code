{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix web",
  "buildCommand": "npm run build --prefix web && rm -rf dist && mkdir dist && cp -R web/out dist/claude-code",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "build": {
    "env": {
      "NEXT_PUBLIC_BASE_PATH": "/claude-code"
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/claude-code/vi/",
      "permanent": false
    },
    {
      "source": "/claude-code/",
      "destination": "/claude-code/vi/",
      "permanent": false
    },
    {
      "source": "/:path((?!claude-code).+)",
      "destination": "/claude-code/:path",
      "permanent": false
    }
  ]
}
